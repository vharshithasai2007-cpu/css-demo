# --- CSS Demo backend configuration ---
# Copy this file to `.env` and adjust values. The backend does not load `.env`
# by itself; start it with `python -m uvicorn main:app --env-file .env`.

# Portal SQLite database (relative to the backend working directory).
CSS_PORTAL_DB_PATH=./data/css_demo.db

# JWT signing secret. Required when CSS_PORTAL_ENV=production.
CSS_PORTAL_SECRET_KEY=change-me-to-a-long-random-string

# Portal token lifetime in minutes.
CSS_PORTAL_TOKEN_MINUTES=120

# Delay between simulated lifecycle steps, in seconds.
CSS_PORTAL_SIM_STEP_SECONDS=45

# development | test | production
CSS_PORTAL_ENV=development

# Run the background lifecycle simulation loop.
CSS_PORTAL_SIM_ENABLED=true

# Generate random simulator tickets on startup (the standalone demo disables
# this so the portal feed only shows real portal submissions).
MOCK_CSS_AUTOGEN=false

# Optional shared secret for the /admin/* demo endpoints. Leave blank to
# disable the check.
CSS_PORTAL_ADMIN_KEY=
